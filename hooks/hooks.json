{
  "hooks": {
    "AfterTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "asoc-tool-telemetry",
            "type": "command",
            "command": "python3 ${extensionPath}/scripts/hooks/telemetry.py",
            "description": "Logs metadata for every tool execution (built-in and MCP)."
          }
        ]
      }
    ],
    "AfterModel": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "token-telemetry",
            "type": "command",
            "command": "python3 ${extensionPath}/scripts/hooks/telemetry.py",
            "description": "Logs token usage metadata for every model response."
          }
        ]
      }
    ]
  }
}
